<?xml version="1.0" encoding="utf-8"?>
<!-- Extension Update Server per plg_content_cfpurge. Elenca le versioni rilasciate. -->
<updates>
    <!-- Bridge for sites that still have the standalone plugin 1.x (plugin / cfpurge / content): the update installs the package over it.
         RELEASE RULE: the <version> of THIS entry stays 2.1.1 for ever (and the same in collection.xml); at each release only its downloadurl and sha256
         follow the newest zip. If it followed the version, a site with the package would be offered the same release twice (plugin and package). -->
    <update>
        <name>Cloudflare Cache Purge</name>
        <description>Clears the Cloudflare cache when your Joomla site changes, from a box on the administrator home page, and through the Joomla Web Services API.</description>
        <element>cfpurge</element>
        <type>plugin</type>
        <folder>content</folder>
        <version>2.1.1</version>
        <maintainer>Marco Galassi (WebG)</maintainer>
        <maintainerurl>https://www.webg.it</maintainerurl>
        <infourl title="WebG">https://www.webg.it</infourl>
        <changelogurl>https://raw.githubusercontent.com/WebG-it/cloudflare-cache-purge/main/changelogs/cfpurge.xml</changelogurl>
        <downloads>
            <downloadurl type="full" format="zip">https://raw.githubusercontent.com/WebG-it/cloudflare-cache-purge/main/dist/pkg_cfpurge-2.1.1.zip</downloadurl>
        </downloads>
        <sha256>59c845860feb822dbf302ca8b555d5dd85e82bc35f2365da84289686aafa308b</sha256>
        <tags>
            <tag>stable</tag>
        </tags>
        <targetplatform name="joomla" version="(5|6)\.[0-9]+" />
        <php_minimum>8.1</php_minimum>
    </update>
    <!-- Sites installed with the package (package / pkg_cfpurge). This entry carries the real version of every release. Same zip, same sha256 as above. -->
    <update>
        <name>Cloudflare Cache Purge</name>
        <description>Clears the Cloudflare cache when your Joomla site changes, from a box on the administrator home page, and through the Joomla Web Services API.</description>
        <element>pkg_cfpurge</element>
        <type>package</type>
        <version>2.1.1</version>
        <maintainer>Marco Galassi (WebG)</maintainer>
        <maintainerurl>https://www.webg.it</maintainerurl>
        <infourl title="WebG">https://www.webg.it</infourl>
        <changelogurl>https://raw.githubusercontent.com/WebG-it/cloudflare-cache-purge/main/changelogs/cfpurge.xml</changelogurl>
        <downloads>
            <downloadurl type="full" format="zip">https://raw.githubusercontent.com/WebG-it/cloudflare-cache-purge/main/dist/pkg_cfpurge-2.1.1.zip</downloadurl>
        </downloads>
        <sha256>59c845860feb822dbf302ca8b555d5dd85e82bc35f2365da84289686aafa308b</sha256>
        <tags>
            <tag>stable</tag>
        </tags>
        <targetplatform name="joomla" version="(5|6)\.[0-9]+" />
        <php_minimum>8.1</php_minimum>
    </update>
</updates>
